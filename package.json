{
  "name": "okx-whale-detector",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "load:test": "tsx src/tools/loadTest.ts",
    "performance:report": "tsx src/tools/performanceReport.ts",
    "whale-tracker:performance": "tsx src/tools/whaleTrackerPerformanceReport.ts",
    "wall-detector:performance": "tsx src/tools/wallDetectorPerformanceReport.ts",
    "behavior-transition:performance": "tsx src/tools/behaviorTransitionPerformanceReport.ts",
    "replay": "tsx src/tools/replayRecording.ts",
    "recording:inspect": "npm run build --silent && node dist/tools/inspectMarketRecording.js",
    "replay:compare": "tsx src/tools/compareReplayReports.ts",
    "alerts:inspect": "npm run build --silent && node dist/tools/inspectCorrelatedAlerts.js",
    "alerts:simulate": "npm run build --silent && node dist/tools/simulateCorrelatedAlerts.js",
    "alerts:evaluate:alignment": "npm run build --silent && node dist/tools/generateAlertAlignmentEvaluations.js",
    "alerts:inspect:alignment": "npm run build --silent && node dist/tools/inspectAlertAlignmentEvaluations.js",
    "alerts:simulate:alignment": "npm run build --silent && node dist/tools/simulateAlertAlignmentEvaluations.js",
    "alerts:evaluate:returns": "npm run build --silent && node dist/tools/generateAlertTerminalReturns.js",
    "alerts:inspect:returns": "npm run build --silent && node dist/tools/inspectAlertTerminalReturns.js",
    "alerts:simulate:returns": "npm run build --silent && node dist/tools/simulateAlertTerminalReturns.js",
    "external:demo": "tsx src/tools/demoExternalSignals.ts",
    "polymarket:scan": "tsx src/tools/scanPolymarketWhales.ts",
    "polymarket:live": "tsx src/tools/watchPolymarketWhales.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
